includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 1
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    # InstallRequirementsInterface only exists since Drupal 11.2.
    -
      message: '#unknown interface Drupal\\Core\\Extension\\InstallRequirementsInterface#'
      path: src/Install/Requirements/LocoTranslateRequirements.php
