<?php

/**
 * @file
 * Primary module hooks for Loco Translate module.
 */

require_once 'inc/cron_pull.inc';
require_once 'inc/cron_push.inc';

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\loco_translate\Hook\CronHook;
use Drupal\loco_translate\Hook\HelpHook;
use Drupal\loco_translate\Hook\ThemeHook;

/**
 * Implements hook_theme().
 *
 * Legacy shim for Drupal < 11.1, see ThemeHook.
 */
#[LegacyHook]
function loco_translate_theme($existing, $type, $theme, $path) {
  return \Drupal::service(ThemeHook::class)($existing, $type, $theme, $path);
}

/**
 * Implements hook_cron().
 *
 * Legacy shim for Drupal < 11.1, see CronHook.
 */
#[LegacyHook]
function loco_translate_cron() {
  \Drupal::service(CronHook::class)();
}

/**
 * Implements hook_help().
 *
 * Legacy shim for Drupal < 11.1, see HelpHook.
 */
#[LegacyHook]
function loco_translate_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(HelpHook::class)($route_name, $route_match);
}
